#include <stdio.h>

struct Field
{
    float moisture;
    float temperature;
    float humidity;
    int cropHealth;
    float latitude;
    float longitude;
};

int main()
{
    struct Field f[50];
    int n, i;

    printf("Enter number of field readings: ");
    scanf("%d", &n);

    // Input field data
    for(i = 0; i < n; i++)
    {
        printf("\nEnter details of field %d:\n", i + 1);

        printf("Soil Moisture: ");
        scanf("%f", &f[i].moisture);

        printf("Temperature: ");
        scanf("%f", &f[i].temperature);

        printf("Humidity: ");
        scanf("%f", &f[i].humidity);

        printf("Crop Health (1-100): ");
        scanf("%d", &f[i].cropHealth);

        printf("GPS Latitude: ");
        scanf("%f", &f[i].latitude);

        printf("GPS Longitude: ");
        scanf("%f", &f[i].longitude);
    }

    // Generate field monitoring report
    printf("\n===== FIELD MONITORING REPORT =====\n");

    for(i = 0; i < n; i++)
    {
        printf("\nField %d\n", i + 1);
        printf("Soil Moisture: %.2f\n", f[i].moisture);
        printf("Temperature: %.2f\n", f[i].temperature);
        printf("Humidity: %.2f\n", f[i].humidity);
        printf("Crop Health: %d\n", f[i].cropHealth);
        printf("GPS Coordinates: %.4f, %.4f\n",
               f[i].latitude, f[i].longitude);

        if(f[i].moisture < 30)
        {
            printf("Irrigation Required\n");
        }
        else
        {
            printf("Irrigation Not Required\n");
        }
    }

    return 0;
}
